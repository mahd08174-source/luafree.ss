<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>LuauProtect | Terms of Service & Privacy Policy</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;800&family=JetBrains+Mono:wght@400;700&family=Fira+Code:wght@400;500&display=swap');

        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --bg-color: #09090b; 
            --card-bg: rgba(18, 18, 20, 0.65); 
            --primary: #6366f1; 
            --primary-hover: #4f46e5;
            --text-main: #f8fafc; 
            --text-muted: #9ca3af; 
            --border: rgba(255, 255, 255, 0.08);
        }

        body { 
            font-family: 'Inter', system-ui, sans-serif; 
            background-color: var(--bg-color); 
            color: var(--text-main); 
            margin: 0; 
            padding: 0; 
            min-height: 100vh; 
            -webkit-font-smoothing: antialiased; 
            position: relative;
        }

        /* --- BACKGROUND ANIMATION --- */
        .code-background {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            display: flex; justify-content: center; align-items: flex-start;
            z-index: 1; pointer-events: none; overflow: hidden;
            opacity: 0.15; 
        }

        .code-column {
            font-family: 'Fira Code', monospace; 
            font-size: 14px; 
            line-height: 1.8;
            white-space: pre; text-align: left;
            animation: scrollCode 60s linear infinite;
        }

        .kw { color: #ff7b72; font-weight: 500; }
        .fn { color: #d2a8ff; }
        .st { color: #a5d6ff; }
        .cm { color: #8b949e; font-style: italic; }
        .op { color: #79c0ff; }
        .vr { color: #c9d1d9; }

        @keyframes scrollCode {
            0% { transform: translateY(0); }
            100% { transform: translateY(-50%); } 
        }

        .vignette {
            position: fixed; inset: 0;
            background: radial-gradient(ellipse at center, transparent 0%, rgba(9,9,11,0.85) 75%, #09090b 100%);
            z-index: 2; pointer-events: none;
        }

        .glass-card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border);
            box-shadow: 0 0 40px rgba(0, 0, 0, 0.8), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
        }

        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #3f3f46; border-radius: 10px; }
    </style>
</head>
<body class="py-10 px-4 sm:px-6 lg:px-8 flex justify-center items-center min-height-screen">

<!-- Background Decryption Matrix -->
<div class="code-background" aria-hidden="true">
    <div class="code-column">
        <div class="code-block">
<span class="cm">-- [Luau Protect] Legal Pipeline Verification</span>
<span class="kw">local</span> <span class="vr">Core</span> <span class="op">=</span> <span class="vr">game</span><span class="op">:</span><span class="fn">GetService</span>(<span class="st">"CoreGui"</span>)
<span class="kw">local</span> <span class="vr">KeySystem</span> <span class="op">=</span> <span class="fn">require</span>(<span class="st">"modules/LicenseManager"</span>)

<span class="kw">function</span> <span class="vr">ProtectScript</span>(<span class="vr">source</span>)
    <span class="kw">local</span> <span class="vr">ast</span> <span class="op">=</span> <span class="fn">parse</span>(<span class="vr">source</span>)
    <span class="vr">ast</span> <span class="op">=</span> <span class="vr">VirtualMachine</span><span class="op">:</span><span class="fn">Wrap</span>(<span class="vr">ast</span>)
    <span class="kw">return</span> <span class="vr">Compiler</span><span class="op">:</span><span class="fn">Build</span>(<span class="vr">ast</span>)
<span class="kw">end</span>
<br><br></div>
        <div class="code-block">
<span class="cm">-- [Luau Protect] Legal Pipeline Verification</span>
<span class="kw">local</span> <span class="vr">Core</span> <span class="op">=</span> <span class="vr">game</span><span class="op">:</span><span class="fn">GetService</span>(<span class="st">"CoreGui"</span>)
<span class="kw">local</span> <span class="vr">KeySystem</span> <span class="op">=</span> <span class="fn">require</span>(<span class="st">"modules/LicenseManager"</span>)

<span class="kw">function</span> <span class="vr">ProtectScript</span>(<span class="vr">source</span>)
    <span class="kw">local</span> <span class="vr">ast</span> <span class="op">=</span> <span class="fn">parse</span>(<span class="vr">source</span>)
    <span class="vr">ast</span> <span class="op">=</span> <span class="vr">VirtualMachine</span><span class="op">:</span><span class="fn">Wrap</span>(<span class="vr">ast</span>)
    <span class="kw">return</span> <span class="vr">Compiler</span><span class="op">:</span><span class="fn">Build</span>(<span class="vr">ast</span>)
<span class="kw">end</span>
<br><br></div>
    </div>
</div>

<div class="vignette"></div>

<!-- Legal Page Content Wrapper -->
<div class="relative z-10 max-w-4xl w-full mx-auto my-auto space-y-8">
    
    <!-- Header Brand -->
    <div class="text-center">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white flex justify-center items-center gap-2">
            <svg class="w-8 h-8 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            Luau<span class="text-indigo-500">Protect</span> Legal Panel
        </h1>
        <p class="mt-2 text-sm text-gray-400">Please review our Terms of Service and Privacy Policy</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- COLUMN 1: TERMS OF SERVICE -->
        <div class="glass-card rounded-2xl p-6 sm:p-8 flex flex-col h-[550px]">
            <div class="border-b border-gray-700/50 pb-3 mb-4">
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    Terms of Service (ToS)
                </h2>
                <p class="text-[11px] text-gray-500 font-mono">Last Updated: July 13, 2026</p>
            </div>

            <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar space-y-5 text-[13px] leading-relaxed text-gray-400">
                <div>
                    <h3 class="font-bold text-gray-200 text-sm mb-1">1. Acceptance of Service</h3>
                    <p class="pl-3 border-l border-indigo-500/20">By accessing and utilizing the LuauProtect infrastructure, you acknowledge that you have read, understood, and agreed to these terms. We reserve the right to modify or update these conditions at any time without prior notice.</p>
                </div>

                <div>
                    <h3 class="font-bold text-gray-200 text-sm mb-1">2. License Keys & HWID Binding</h3>
                    <div class="pl-3 border-l border-indigo-500/20 space-y-2">
                        <p>• <strong>Strictly Personal:</strong> Every license key generated through our panels is strictly personal, unique, and non-transferable.</p>
                        <p>• <strong>Hardware Locking:</strong> Our system automatically binds each key to the Hardware ID (HWID) of the first device that claims it.</p>
                        <p>• <strong>Bypass & Abuse Policy:</strong> Any attempt to spoof, emulate, alter, transfer, or bypass the HWID verification, or engage in unauthorized resale of keys, will result in the immediate revocation of the key and a permanent HWID Ban across our entire network.</p>
                    </div>
                </div>

                <div>
                    <h3 class="font-bold text-gray-200 text-sm mb-1">3. Intellectual Property</h3>
                    <p class="pl-3 border-l border-indigo-500/20">We do not claim ownership of your uploaded scripts; however, it is strictly prohibited to use our services to protect malicious software, account stealers (loggers), malware, or content that violates Roblox or Discord Terms of Service.</p>
                </div>

                <div>
                    <h3 class="font-bold text-gray-200 text-sm mb-1">4. Security & Leaks</h3>
                    <p class="pl-3 border-l border-indigo-500/20">In the event of a leak, bypass, or vulnerability disclosure affecting our protection or auth system, our team will act as fast as possible to push a real-time update (hotfix) and patch the flaw immediately to ensure the integrity of your scripts.</p>
                </div>

                <div>
                    <h3 class="font-bold text-gray-200 text-sm mb-1">5. System Availability</h3>
                    <p class="pl-3 border-l border-indigo-500/20">We strive to maintain 99.9% uptime, but we are not responsible for revenue loss due to server maintenance, base platform changes, or hosting provider outages.</p>
                </div>
            </div>
        </div>

        <!-- COLUMN 2: PRIVACY POLICY -->
        <div class="glass-card rounded-2xl p-6 sm:p-8 flex flex-col h-[550px]">
            <div class="border-b border-gray-700/50 pb-3 mb-4">
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                    Privacy Policy
                </h2>
                <p class="text-[11px] text-gray-500 font-mono">Last Updated: July 13, 2026</p>
            </div>

            <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar space-y-5 text-[13px] leading-relaxed text-gray-400">
                <div>
                    <h3 class="font-bold text-gray-200 text-sm mb-1">1. Information We Collect</h3>
                    <div class="pl-3 border-l border-indigo-500/20 space-y-2">
                        <p>• <strong>Discord Data (OAuth2):</strong> When logging in, we store your Discord User ID, Username, and Avatar hash/URL. We never request or store passwords.</p>
                        <p>• <strong>Hardware Identifiers (HWID):</strong> When a user runs a protected script, our loader securely captures your hardware hash to validate active licenses.</p>
                        <p>• <strong>Uploaded Code:</strong> We temporarily or permanently store your uploaded scripts to apply our custom security obfuscation and decryption pipeline.</p>
                    </div>
                </div>

                <div>
                    <h3 class="font-bold text-gray-200 text-sm mb-1">2. How We Use Data</h3>
                    <p class="pl-3 border-l border-indigo-500/20">Your data is processed strictly to authenticate your dashboard sessions, validate key usage, restrict multi-device licensing abuse, and conduct basic security scans to safeguard the backend ecosystem.</p>
                </div>

                <div>
                    <h3 class="font-bold text-gray-200 text-sm mb-1">3. Data Protection</h3>
                    <p class="pl-3 border-l border-indigo-500/20">Uploaded scripts are heavily encrypted and isolated. We implement strict server-side access controls to ensure your original source code is safe. LuauProtect strictly commits to never share, sell, or rent any personal logs or scripts with third parties.</p>
                </div>

                <div>
                    <h3 class="font-bold text-gray-200 text-sm mb-1">4. Data Retention & Erasure</h3>
                    <p class="pl-3 border-l border-indigo-500/20">Active keys and HWID logs exist while active. If you want your panels, scripts, or profile completely wiped from our infrastructure database, you can request full erasure via our support server at any time.</p>
                </div>
            </div>
        </div>

    </div>

    <!-- Bottom Actions -->
    <div class="flex justify-center pt-2">
        <a href="/" class="glass-card hover:bg-gray-800/80 text-white text-[13px] font-medium py-3 px-6 rounded-xl border border-gray-700/50 transition-all duration-200 flex items-center justify-center gap-2 hover:-translate-y-0.5 shadow-lg">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Return to Login Screen
        </a>
    </div>

</div>

